#!/usr/bin/env python3
"""Check explicit Git identity and the installed workspace delivery contract."""
import os
from pathlib import Path
import subprocess
import sys

import harness_common as common


def main():
    phase = sys.argv[1] if len(sys.argv) > 1 else 'check'
    common.require(phase in ('check', 'pre-commit', 'pre-merge-commit', 'commit-msg', 'pre-push'), '알 수 없는 hook 단계입니다.')
    common.load_config()
    if phase in ('pre-commit', 'pre-merge-commit', 'commit-msg'):
        name = common.git(Path.cwd(), 'config', '--get', 'user.name', optional=True)
        email = common.git(Path.cwd(), 'config', '--get', 'user.email', optional=True)
        common.require(name.strip() and email.strip(), 'commit에는 명시적인 user.name과 user.email이 필요합니다.')
        for role in ('AUTHOR', 'COMMITTER'):
            # Preserve identity overrides here so an unintended override is detected.
            env = common.git_environment()
            env.update({key: value for key, value in os.environ.items() if key.startswith(('GIT_AUTHOR_', 'GIT_COMMITTER_'))})
            ident = subprocess.check_output(['git', 'var', 'GIT_' + role + '_IDENT'], env=env, text=True).strip().rsplit(' ', 2)[0]
            common.require(ident == f'{name} <{email}>', f'Git {role}가 user.name/user.email과 다릅니다. identity override를 확인하세요.')
    _, _, checkout, _ = common.checkout_info(Path.cwd())
    args = [sys.executable, str(Path(__file__).with_name('work.py')), 'check', '--cwd', str(checkout)]
    if phase != 'check':
        args.append('--delivery')
    subprocess.run(args, check=True)
    print(f'workspace check ({phase}): OK')


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, subprocess.SubprocessError) as error:
        print(f'workspace check: {error}', file=sys.stderr)
        sys.exit(1)
